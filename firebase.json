{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["pnpm --dir \"$RESOURCE_DIR\" build"],
      "ignore": ["node_modules", "src", "*.log", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
